# Copy to .env and fill in.

# Shared secret Centerfy must send with each webhook (header: x-bridge-secret).
# Invent a long random string; put the same value in the Centerfy webhook headers.
BRIDGE_SECRET=

# MogulOS agency Private Integration Token (create in MogulOS, not Centerfy).
# Scopes: Contacts (view + write), Notes (write), Locations (view),
#         plus Calendars (write) if you book appointments.
# Locations-view lets `npm run verify` confirm your ids resolve.
MOGULOS_PIT_TOKEN=

# LeadConnector API host — correct for all white-label GHL, incl. MogulOS.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# Path to the route -> MogulOS location map (see routing.example.json).
ROUTING_MAP=./routing.json

# Fallback MogulOS location id if an incoming "route" is unknown.
DEFAULT_LOCATION_ID=

PORT=4000
