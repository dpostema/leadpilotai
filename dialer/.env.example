# Copy to .env and fill in from your Centerfy dialer sub-account.
# Settings -> Private Integrations -> create a token with these scopes:
#   Contacts (view + write), Workflows (view + write), Locations (view)
# Locations-view lets `npm run verify` confirm your ids resolve.
CENTERFY_PIT_TOKEN=

# The Location (sub-account) ID of your Centerfy dialer account.
# Find it in the browser URL when inside the sub-account: /v2/location/<THIS_ID>/...
CENTERFY_LOCATION_ID=

# The workflow that runs the outbound voice-AI calling campaign in Centerfy.
# Automation -> Workflows -> open the calling workflow -> copy the ID from the URL.
# Leave blank to only create contacts without enrolling them in a campaign.
CENTERFY_WORKFLOW_ID=

# LeadConnector API host (default is correct for all white-label GHL, incl. Centerfy).
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# Default country for phone normalization (NANP: US/CA). Two-letter code.
DEFAULT_COUNTRY=US
